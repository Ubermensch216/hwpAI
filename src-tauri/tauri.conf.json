{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hwp+AI Editor",
  "mainBinaryName": "hwpai",
  "version": "0.8.4",
  "identifier": "com.hwp.ai.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:7700",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hwp+AI Editor",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["hwpx", "hwp", "hml"],
        "name": "HWPX Document",
        "description": "HWP / HWPX Document File",
        "role": "Editor"
      }
    ]
  }
}
